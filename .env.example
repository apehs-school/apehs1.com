# Neon Postgres connection string. This project already has a database named APEHS.
DATABASE_URL=

# Clerk. Create an application at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# Comma-separated emails that become admins the first time they sign in.
ADMIN_EMAILS=

# Stripe. Use a restricted key with Checkout and webhook access.
# Do not put the secret key in client-side code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL used for Stripe return links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Neon Object Storage. Images and documents are public. Other files stay private.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
